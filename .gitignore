.gradle/
build/
.kotlin/
local.properties

# kotlin-js-store/yarn.lock IS committed: it pins the npm dependency tree that JS and Wasm
# tests resolve, so leaving it out would make those targets non-reproducible in CI.
kotlin-js-store/*
!kotlin-js-store/yarn.lock
.idea/
*.iml
.DS_Store

# Heap dumps, e.g. from a Kotlin/Native compiler OOM
*.hprof
